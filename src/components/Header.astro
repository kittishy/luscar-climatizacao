---
/**
 * Site header.
 *
 * Two navigation states, chosen by space rather than by device guesswork:
 *   < 1024px  logo + a real toggle opening a scrollable panel
 *   >= 1024px full inline navigation
 *
 * The panel is a <nav> containing ordinary links, so it works by keyboard and
 * touch without any framework. JavaScript only manages open/closed state,
 * Escape, and returning focus to the toggle.
 */
import { photos, logoUrl, routes, site, whatsappLink, whatsappIntents } from '../data/site.js';

const current = Astro.url.pathname;

const navItems = [
  { label: 'Serviços', href: routes.servicos },
  { label: 'Trabalhos', href: routes.projects },
  { label: 'Sobre', href: routes.about },
  { label: 'Contato', href: routes.contact },
];

function isCurrent(href: string): boolean {
  if (href === routes.home) return current === routes.home;
  return current === href || current.startsWith(href);
}

const ctaHref = whatsappLink(whatsappIntents.geral);
const logo = photos.logo;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={routes.home} aria-label={`${site.name} — página inicial`}>
      <img
        src={logoUrl}
        alt={site.name}
        width={logo.width}
        height={logo.height}
        decoding="async"
      />
      <span class="brand__text">Climatização<br />Joinville e região</span>
    </a>

    <nav class="site-nav" aria-label="Navegação principal">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--on-deep header-cta" href={ctaHref} rel="noopener">
      Pedir orçamento
    </a>

    <button
      class="nav-toggle"
      type="button"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-panel"
    >
      <span class="nav-toggle__bars" aria-hidden="true"><span></span></span>
      <span class="visually-hidden">Abrir menu de navegação</span>
    </button>
  </div>

  <nav class="nav-panel" id="nav-panel" data-open="false" aria-label="Navegação principal (compacto)">
    <div class="nav-panel__group">
      <p class="nav-panel__label">Navegação</p>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                class="nav-panel__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="nav-panel__group">
      <p class="nav-panel__label">Serviços</p>
      <ul>
        <li><a class="nav-panel__link" href={routes.instalacao}>Instalação</a></li>
        <li><a class="nav-panel__link" href={routes.manutencao}>Manutenção e consertos</a></li>
        <li><a class="nav-panel__link" href={routes.altura}>Acesso por cordas</a></li>
        <li><a class="nav-panel__link" href={routes.limpeza}>Limpeza</a></li>
        <li><a class="nav-panel__link" href={routes.pex}>Tubulação PEX/EPEX</a></li>
      </ul>
    </div>

    <div class="nav-panel__cta">
      <a class="btn btn--on-deep btn--block" href={ctaHref} rel="noopener">Pedir orçamento</a>
      <a class="btn btn--ghost-on-deep btn--block" href={routes.contact} style="margin-top:.75rem">
        Ver canais de contato
      </a>
    </div>
  </nav>
</header>

<script>
  /**
   * Compact navigation panel.
   *
   * Progressive enhancement: without this script the desktop nav still works
   * and the panel stays closed.
   *
   * Focus handling, in order of the interaction it solves:
   *   - on open, every element OUTSIDE the panel and the toggle gets `inert`,
   *     so Tab cannot wander to controls hidden behind the panel. The browser
   *     removes them from the focus order and from the accessibility tree, and
   *     hides them from assistive tech rather than merely ignoring keystrokes.
   *   - focus moves to the first link inside the panel.
   *   - Tab is kept inside the panel by wrapping from last to first.
   *   - Shift+Tab from the first element returns focus to the toggle.
   *   - Escape closes and returns focus to the toggle.
   *
   * `inert` is used because it is a single declarative attribute that fixes
   * focus, scrolling and accessibility exposure together, rather than a
   * hand-rolled trap that can leak.
   */
const toggle = document.getElementById('nav-toggle');
    const panel = document.getElementById('nav-panel');

    if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
      const main = document.getElementById('conteudo');
      const footer = document.querySelector('.site-footer');
      const contactBar = document.querySelector('.contact-bar');
      // The skip link sits outside <main>, and the brand link sits inside the
      // header but above the panel, so both need the same treatment or they
      // stay reachable controls while the panel covers the page. The toggle
      // itself is deliberately excluded: Shift+Tab from the first panel item
      // must be able to land on it to close the menu.
      const skipLink = document.querySelector('.skip-link');
      const brand = document.querySelector('.brand');

      /** Elements that must not be reachable while the panel is open. */
      const background = [main, footer, contactBar, skipLink, brand].filter(
        (el): el is HTMLElement => el instanceof HTMLElement,
      );

    const focusables = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ).filter((el) => el.getBoundingClientRect().height > 0);

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.dataset.open = String(open);
      const label = toggle.querySelector('.visually-hidden');
      if (label) {
        label.textContent = open ? 'Fechar menu de navegação' : 'Abrir menu de navegação';
      }

      for (const el of background) {
        if (open) el.setAttribute('inert', '');
        else el.removeAttribute('inert');
      }

      // Stop the page behind the panel from scrolling on touch devices.
      document.documentElement.style.overflow = open ? 'hidden' : '';

      if (open) {
        focusables()[0]?.focus();
      }
    };

    toggle.addEventListener('click', () => {
      const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(willOpen);
      if (!willOpen) toggle.focus();
    });

    document.addEventListener('keydown', (event) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;

      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }

      if (event.key !== 'Tab') return;

      const items = focusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;

      // Wrap forward from the last item, and backward from the first, so
      // focus stays inside the panel instead of escaping to the page behind.
      if (event.shiftKey && active === first) {
        event.preventDefault();
        toggle.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Following a link inside the panel must not leave it stuck open.
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });

    // Leaving the small-screen range must not strand the open panel state, and
    // must release the `inert` background set on open.
    const wide = window.matchMedia('(min-width: 1024px)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>