---
/**
 * FAQ built on native <details>/<summary>.
 *
 * The FAQ exists to help the visitor, not to win a rich result. Google's
 * documentation records that the FAQ rich result was withdrawn from desktop
 * and mobile search in 2026, so no FAQPage markup is emitted and no claim of
 * rich-result eligibility is made anywhere.
 *
 * Answers are rendered as text plus an optional link. No raw HTML is ever
 * injected, so authoring a new answer cannot introduce a script injection.
 */
interface FaqItem {
  q: string;
  a: string;
  /** Optional "go deeper" link appended after the answer text. */
  link?: { text: string; href: string };
}

interface Props {
  items: readonly FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item">
        <summary>{item.q}</summary>
        <div class="faq__answer">
          <p>
            {item.a}
            {item.link && (
              <>
                {' '}
                <a href={item.link.href}>{item.link.text}</a>
              </>
            )}
          </p>
        </div>
      </details>
    ))
  }
</div>