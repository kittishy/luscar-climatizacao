---
/**
 * Fixed contact bar for small viewports only (< 1024px).
 *
 * Deliberately not shown on desktop, where the header button and the in-page
 * CTAs already cover the action. The brief is explicit that a fixed bar and a
 * floating bubble must never coexist, so there is exactly one affordance here
 * and no bubble anywhere on the site.
 *
 * `contacts.phoneDisplay` is rendered inside an aria-label because the visual
 * form is not what a screen reader should announce.
 */
import { contacts, whatsappIntents, whatsappLink } from '../data/site.js';

interface Props {
  message?: string;
  label?: string;
}

const { message = whatsappIntents.geral, label = 'Falar com o técnico no WhatsApp' } = Astro.props;
const href = whatsappLink(message);
---

<div class="contact-bar">
  <a href={href} rel="noopener" aria-label={`${label}, ${contacts.phoneDisplay}`}>
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.25 8.23a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23Zm-2.6 4.03c-.19 0-.5.07-.76.35-.26.28-1 .98-1 2.39s1.03 2.77 1.17 2.96c.15.2 2 3.2 4.94 4.36 2.44.97 2.94.78 3.47.72.53-.05 1.71-.7 1.95-1.37.24-.68.24-1.26.17-1.38-.07-.12-.26-.19-.55-.33-.29-.15-1.71-.84-1.98-.94-.26-.1-.46-.15-.65.14-.19.3-.74.94-.9 1.13-.17.19-.33.21-.62.07-.29-.15-1.23-.45-2.34-1.44-.86-.77-1.44-1.72-1.61-2.01-.17-.29-.02-.45.13-.59.13-.13.29-.33.43-.5.15-.16.2-.29.29-.48.1-.19.05-.36-.02-.5-.07-.15-.64-1.57-.89-2.14-.23-.55-.47-.48-.65-.49h-.55Z"
      ></path>
    </svg>
    <span>Falar com o técnico</span>
  </a>
</div>