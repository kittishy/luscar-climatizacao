---
/**
 * Home.
 *
 * Section order follows 02-DIRECAO-VISUAL-E-MOBILE.md:
 *   hero -> serviços -> acesso em altura (deep) -> galeria -> como solicitar
 *   -> bloco humano -> dúvidas -> contato
 *
 * Surfaces alternate white / ice / deep on purpose, and each block uses the
 * layout its content wants rather than repeating one grid.
 */
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { serviceGroups, whatsappIntents, whatsappLink, routes, site, sizes } from '../data/site.js';

export const meta = {
  route: '/',
  title: 'Ar-condicionado em Joinville | Luscar Climatização',
  description:
    'Instalação, manutenção e limpeza de ar-condicionado em Joinville, com acesso por cordas e tubulação PEX/EPEX. Converse com a Luscar.',
  h1: 'Ar-condicionado em Joinville, da instalação ao cuidado diário.',
};

const ctaHref = whatsappLink(whatsappIntents.geral);

const faqItems = [
  {
    q: 'Quanto custa a instalação?',
    a: 'O orçamento depende do aparelho, da infraestrutura e das condições de acesso. Envie as informações que tiver pelo WhatsApp para conversar sobre a avaliação.',
    link: { text: 'Ver o que informar para o orçamento.', href: routes.instalacao },
  },
  {
    q: 'Vocês trabalham em prédios e apartamentos?',
    a: 'Sim. A Luscar trabalha com instalações em prédios e apartamentos, incluindo serviços com acesso por cordas.',
    link: { text: 'Entender o acesso por cordas.', href: routes.altura },
  },
  {
    q: 'Meu ar-condicionado não está gelando. Já preciso trocar?',
    a: 'A perda de desempenho pode ter diferentes causas. Relate os sintomas ao técnico para avaliar o caso antes de decidir por reparo ou troca.',
    link: { text: 'Ler o guia sobre o aparelho que não gela.', href: routes.guiaNaoGela },
  },
  {
    q: 'Com que frequência devo limpar o aparelho?',
    a: 'A necessidade varia conforme uso, ambiente e orientação do fabricante. A avaliação ajuda a definir o cuidado adequado para o equipamento.',
    link: { text: 'Sobre limpeza de ar-condicionado.', href: routes.limpeza },
  },
  {
    q: 'PEX serve para qualquer instalação?',
    a: 'A compatibilidade depende das características do sistema e da tubulação especificada. Converse sobre o projeto antes de escolher o material.',
    link: { text: 'Como a Luscar trata tubulação flexível.', href: routes.pex },
  },
  {
    q: 'Como peço um orçamento?',
    a: 'Fale pelo WhatsApp e informe o serviço desejado. Fotos do aparelho e do local ajudam a iniciar a conversa.',
    link: { text: 'Ver todos os canais de contato.', href: routes.contact },
  },
];
---

<Base meta={meta} barMessage={whatsappIntents.geral}>
  {/* ---- 1. Hero: text and a real photograph of work at height -------------- */}
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Climatização em {site.region}</p>
        <h1 class="hero__title">{meta.h1}</h1>
        <p class="lead hero__lead">
          Instalação, manutenção e limpeza de ar-condicionado, com atendimento para prédios
          e apartamentos e acesso por cordas quando o local exige. A Luscar também trabalha
          com tubulação flexível PEX/EPEX.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={ctaHref} rel="noopener">Falar com o técnico</a>
          <a class="link-more" href={routes.servicos}>Conhecer os serviços</a>
        </div>
        <div class="hero__meta">
          <dl>
            <div>
              <dt>Atendimento</dt>
              <dd style="margin:0">{site.regionFull}</dd>
            </div>
            <div>
              <dt>Contato</dt>
              <dd style="margin:0">
                <a href={ctaHref} rel="noopener">WhatsApp (47) 8482-4814</a>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <figure class="hero__figure">
        <div class="hero__media">
          <Figure
            photo="heroTecnico"
            sizes={sizes.hero}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="hero__caption">
          Climatização com acesso por cordas
        </figcaption>
      </figure>
    </div>
  </section>

  {/* ---- 2. Services: editorial groups, not repeated icon cards ------------ */}
  <section class="section section--ice" aria-labelledby="servicos-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">O que a Luscar faz</p>
        <h2 id="servicos-title">Serviços da Luscar</h2>
        <p class="lead">
          Quatro frentes de atendimento. Cada uma tem uma página própria com o que costuma
          perguntar, o que é avaliado e que informações ajudam a iniciar a conversa.
        </p>
      </div>

      <div class="services-grid">
        {
          serviceGroups.map((group) => (
            <article class="service-group">
              <h3 class="service-group__title">{group.title}</h3>
              <p class="service-group__lead">{group.lead}</p>
              <p class="service-group__detail">{group.detail}</p>
              <a class="link-more" href={group.route}>
                Ver sobre {group.title.toLowerCase()}
              </a>
            </article>
          ))
        }
      </div>

      <ul class="service-hub-link" role="list">
        <li><a href={routes.instalacao}>Instalação de ar-condicionado</a></li>
        <li><a href={routes.manutencao}>Manutenção e consertos</a></li>
        <li><a href={routes.limpeza}>Limpeza de ar-condicionado</a></li>
        <li><a href={routes.altura}>Prédios e apartamentos</a></li>
        <li><a href={routes.pex}>Tubulação PEX/EPEX</a></li>
      </ul>
    </div>
  </section>

  {/* ---- 3. Access by rope: the deep blue moment --------------------------- */}
  <section class="section section--deep section--lg on-deep" aria-labelledby="altura-title">
    <div class="container altitude">
      <figure class="altitude__media">
        <Figure
          photo="alpinismoFachada"
          sizes={sizes.feature}
        />
      </figure>
      <div class="altitude__copy">
        <p class="eyebrow eyebrow--on-deep">Acesso por cordas</p>
        <h2 id="altura-title">Quando o acesso faz parte do serviço</h2>
        <p>
          Em prédios e apartamentos, o caminho até a unidade externa também precisa ser
          considerado. A Luscar atua com acesso por cordas para trabalhos em locais de difícil
          alcance.
        </p>
        <p>
          A conversa começa com as condições do imóvel e a necessidade do serviço — não com a
          garantia de que qualquer fachada pode ser trabalhada.
        </p>
        <p><a class="link-more" href={routes.altura}>Como funciona o acesso por cordas</a></p>
      </div>
    </div>
  </section>

  {/* ---- 4. Documentary gallery -------------------------------------------- */}
  <section class="section" aria-labelledby="trabalhos-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Registro do trabalho</p>
        <h2 id="trabalhos-title">Trabalhos da Luscar</h2>
        <p class="lead">
          Veja registros publicados pela empresa e conheça diferentes situações de instalação
          e atendimento. As legendas descrevem o que aparece na fotografia.
        </p>
      </div>

      <Gallery
        items={['condensadorFachada', 'rapelServico', 'instalacaoInterna', 'predioInstalacoes', 'tecnicoInstrumentos', 'alpinismoFachada']}
        wideIndices={[0, 4]}
      />

      <p style="margin-top:1.75rem">
        <a class="link-more" href={routes.projects}>Ver a galeria completa</a>
      </p>
    </div>
  </section>

  {/* ---- 5. How to ask for service: guidance, not a scheduling promise ----- */}
  <section class="section section--ice" aria-labelledby="solicitar-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Primeiro contato</p>
        <h2 id="solicitar-title">Como solicitar atendimento</h2>
        <p class="lead">
          Três passos simples para a conversa começar com contexto. A avaliação e o orçamento
          são combinados com o técnico depois disso.
        </p>
      </div>

      <ol class="steps">
        <li>
          <h3>Conte o que você precisa</h3>
          <p>
            Instalação, manutenção, limpeza, um serviço em altura ou um projeto de tubulação.
            Se souber o modelo e a capacidade do aparelho, informe.
          </p>
        </li>
        <li>
          <h3>Envie fotos do local</h3>
          <p>
            Fotos do aparelho, da fachada ou do ponto onde o serviço seria feito ajudam a
            entender a situação antes da conversa.
          </p>
        </li>
        <li>
          <h3>Converse sobre a avaliação</h3>
          <p>
            Com essas informações em mãos, o técnico discute o escopo do serviço e o
            orçamento. A disponibilidade para o seu endereço é confirmada nessa conversa.
          </p>
        </li>
      </ol>

      <p style="margin-top:1.75rem">
        <a class="link-more" href={routes.contact}>Ver todos os canais de contato</a>
      </p>
    </div>
  </section>

  {/* ---- 6. Human block ---------------------------------------------------- */}
  <section class="section" aria-labelledby="sobre-title">
    <div class="container human">
      <figure class="human__media">
        <Figure photo="lucasRetrato" sizes={sizes.humanPortrait} />
        <figcaption class="hero__caption">
          Perfil público da Luscar no Instagram
        </figcaption>
      </figure>
      <div>
        <p class="eyebrow">Quem faz</p>
        <h2 id="sobre-title">Climatização com o trabalho à vista</h2>
        <p class="lead">
          A Luscar Climatização atende em {site.regionFull} com serviços de instalação,
          manutenção, acesso por cordas e tubulação flexível.
        </p>
        <ul class="human__facts" role="list">
          <li><strong>Atuação</strong><span>{site.regionFull}</span></li>
          <li><strong>Serviços</strong><span>Instalação, manutenção, limpeza, acesso por cordas e PEX/EPEX</span></li>
          <li><strong>Contato</strong><span>WhatsApp (47) 8482-4814</span></li>
        </ul>
        <p style="margin-top:1.25rem">
          <a class="link-more" href={routes.about}>Conhecer a Luscar</a>
        </p>
      </div>
    </div>
  </section>

  {/* ---- 7. Useful questions ---------------------------------------------- */}
  <section class="section section--ice" aria-labelledby="duvidas-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Antes de falar com a gente</p>
        <h2 id="duvidas-title">Dúvidas sobre climatização</h2>
        <p class="lead">
          Respostas curtas às perguntas que mais aparecem. Cada uma leva à página que explica
          o assunto com mais detalhe.
        </p>
      </div>
      <Faq items={faqItems} />
    </div>
  </section>

  {/* ---- 8. Closing contact ----------------------------------------------- */}
  <ClosingCta />
</Base>