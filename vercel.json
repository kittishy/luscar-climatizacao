{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ola-mundo/",
      "destination": "/api/gone"
    },
    {
      "source": "/pagina-exemplo/",
      "destination": "/api/gone"
    },
    {
      "source": "/author/projetos/",
      "destination": "/api/gone"
    },
    {
      "source": "/category/sem-categoria/",
      "destination": "/api/gone"
    }
  ]
}
