# dependencies
node_modules/

# build output
dist/
.astro/

# Vercel
.vercel/

# NOTE: vercel.json is deliberately COMMITTED, not ignored.
#
# Vercel reads project configuration (headers, rewrites, the four 410s) from
# the repository BEFORE the build runs. The build regenerates vercel.json, but
# by then the routing and header layer has already been configured. Ignoring it
# therefore produced a deploy with NO X-Robots-Tag and NO 410 rewrites, while
# the file on disk looked correct. tests/deploy-config.test.ts now fails the
# build if it is missing or does not contain the required rules.

# editor / OS
.DS_Store
Thumbs.db
*.log
.vercel
